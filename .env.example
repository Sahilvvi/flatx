# Mumbai Rent Intelligence Platform — environment variables
# Copy this file to .env.local and fill in real values for local development.
# On Vercel, configure these in Project Settings → Environment Variables.

# --- Supabase ---
# From https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is used ONLY on the server (API routes) for privileged writes.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mapbox ---
# From https://account.mapbox.com/access-tokens/
# A public token (pk.*) is fine; restrict it to your domain in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# --- App config (optional) ---
# Map default center (Mumbai: 19.0760, 72.8777) and zoom
NEXT_PUBLIC_DEFAULT_LAT=19.0760
NEXT_PUBLIC_DEFAULT_LNG=72.8777
NEXT_PUBLIC_DEFAULT_ZOOM=11

# Rate-limit window (seconds) and max requests per IP for write endpoints
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20

# Canonical site URL used for OG / Twitter metadata.
# Set to your production URL in Vercel (e.g. https://mri.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin panel (/admin) ---
# Comma-separated list of emails allowed to access /admin.
# Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=
